rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'volcanokw@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Pillar 2: Validation Blueprint for OrbitWorkspaceSnapshot
    function isValidOrbitWorkspaceSnapshot(data) {
      return data.keys().hasAll([
          'ownerUid',
          'ownerEmail',
          'workspaceName',
          'fleetCount',
          'payloadJson',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerUid',
          'ownerEmail',
          'workspaceName',
          'fleetCount',
          'payloadJson',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerUid is string &&
        data.ownerUid.size() >= 1 &&
        data.ownerUid.size() <= 128 &&
        data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid == request.auth.uid &&
        data.ownerEmail is string &&
        data.ownerEmail.size() >= 3 &&
        data.ownerEmail.size() <= 254 &&
        data.workspaceName is string &&
        data.workspaceName.size() >= 1 &&
        data.workspaceName.size() <= 120 &&
        data.fleetCount is int &&
        data.fleetCount >= 0 &&
        data.fleetCount <= 500 &&
        data.payloadJson is string &&
        data.payloadJson.size() >= 2 &&
        data.payloadJson.size() <= 900000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list, create, update, delete: if false;
    }

    match /orbit_snapshots/{snapshotId} {
      allow get: if isSignedIn() &&
        isValidId(snapshotId) &&
        (resource == null || existing().ownerUid == request.auth.uid || isAdmin());

      allow list: if isSignedIn() &&
        (resource.data.ownerUid == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
        isValidId(snapshotId) &&
        isValidOrbitWorkspaceSnapshot(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isSignedIn() &&
        isValidId(snapshotId) &&
        isValidOrbitWorkspaceSnapshot(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().ownerEmail == existing().ownerEmail &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            existing().ownerUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'workspaceName',
              'fleetCount',
              'payloadJson',
              'updatedAt'
            ])
          ) ||
          isAdmin()
        );

      allow delete: if isSignedIn() &&
        isValidId(snapshotId) &&
        (existing().ownerUid == request.auth.uid || isAdmin());
    }
  }
}
