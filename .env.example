# GEMINI_API_KEY: Required for optional on-demand Gemini AI incident diagnosis.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GITHUB_READ_ONLY_TOKEN: Optional fine-grained personal access token (Read-Only)
# Used by the ORBIT server to fetch private repositories, Actions runs, and commits
# for owner ProfAlfailakawi without exposing credentials to the client.
GITHUB_READ_ONLY_TOKEN=""

# ORBIT_OPERATOR_PASSKEY is REQUIRED in the hosting environment. Set a random value >=16 characters; do not commit it.
ORBIT_OPERATOR_PASSKEY=""

# ORBIT_WEBHOOK_SECRET: Optional HMAC-SHA256 secret for verifying incoming GitHub / Sensor webhooks
ORBIT_WEBHOOK_SECRET=""

# OPTIONAL legacy single-app ORBIT Sensor integration. Both values are required.
# Prefer ORBIT_SENSOR_CREDENTIALS for independently revocable app-scoped credentials.
ORBIT_SENSOR_INGEST_TOKEN=""
ORBIT_SENSOR_APP_ID=""

# JSON object of app code to 32+ character server-side credential.
# Example shape only: {"MIRAS":"replace-with-strong-random-secret"}
# Never embed these credentials in public browser bundles.
ORBIT_SENSOR_CREDENTIALS="{}"

# Number of reverse-proxy hops explicitly trusted for client IP derivation. Keep 0
# unless the deployment topology is known and verified.
ORBIT_TRUST_PROXY_HOPS="0"

# Production persistence and scheduler (Cloud Run uses its attached service identity)
DATA_STORE=firestore
FIREBASE_PROJECT_ID=orbit-one-orbit-2026
FIREBASE_DATABASE_ID=(default)
SCHEDULER_AUDIENCE=
SCHEDULER_SERVICE_ACCOUNT=
SCHEDULER_ONLY=true
