# GEMINI_API_KEY: Required for optional on-demand Gemini AI incident diagnosis.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GITHUB_READ_ONLY_TOKEN: Optional fine-grained personal access token (Read-Only)
# Used by the ORBIT server to fetch private repositories, Actions runs, and commits
# for owner ProfAlfailakawi without exposing credentials to the client.
GITHUB_READ_ONLY_TOKEN=""

# ORBIT_OPERATOR_PASSKEY: Optional passkey for operator authentication (defaults to orbit-2026-admin in preview)
ORBIT_OPERATOR_PASSKEY="orbit-2026-admin"

# ORBIT_WEBHOOK_SECRET: Optional HMAC-SHA256 secret for verifying incoming GitHub / Sensor webhooks
ORBIT_WEBHOOK_SECRET=""
