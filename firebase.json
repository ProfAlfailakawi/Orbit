{
  "hosting": {
    "target": "production",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "server.mjs"],
    "rewrites": [
      { "source": "/api/**", "run": { "serviceId": "orbit-api", "region": "me-central1" } },
      { "source": "/healthz", "run": { "serviceId": "orbit-api", "region": "me-central1" } },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      { "source": "**", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }] }
    ]
  },
  "firestore": { "rules": "firestore.rules" }
}
